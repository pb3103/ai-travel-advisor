# Copy to .env at the repo root — docker-compose reads it automatically.

# Required: your OpenRouter API key (used for all LLM calls).
OPENROUTER_API_KEY=

# Optional: override the model used by the advisor agent (must support
# streaming chat completions on OpenRouter — check what's available to your
# key at https://openrouter.ai/api/v1/models before changing this).
# ADVISOR_MODEL=anthropic/claude-sonnet-5
# for free usage: ADVISOR_MODEL=openrouter/free

# Only needed when running the backend outside docker-compose.
# DATABASE_URL=postgresql+psycopg://advisor:advisor@localhost:5432/advisor
